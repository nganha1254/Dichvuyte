@model IEnumerable<Doan.Models.TbService>

@{
    ViewData["Title"] = "Quản lý Dịch vụ";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="row">
        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Quản lý Dịch vụ</h4>

                    <p class="card-description">
                        <a asp-action="Create" class="btn btn-success">Thêm mới</a>
                    </p>

                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Tiêu đề</th>
                                    <th>Alias</th>
                                    <th style="width:90px">Ảnh</th>
                                    <th>Giá</th>
                                    <th>Giá KM</th>
                                    <th>Danh mục</th>
                                    <th>Bác sĩ</th>
                                    <th>Hiển thị</th>
                                    <th style="width:200px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int i = 1;
                                }

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@(i++)</td>

                                        <td>@item.Title</td>

                                        <td>@item.Alias</td>

                                        <td>
                                            @if (!string.IsNullOrEmpty(item.Image))
                                            {
                                                <img src="@item.Image"
                                                     width="50"
                                                     height="50"
                                                     style="object-fit:cover;border-radius:4px;" />
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>

                                        <td>
                                            @(item.Price.HasValue
                                                ? string.Format("{0:N0} đ", item.Price)
                                                : "-")
                                        </td>

                                        <td>
                                            @(item.PriceSale.HasValue
                                                ? string.Format("{0:N0} đ", item.PriceSale)
                                                : "-")
                                        </td>

                                        <td>
                                            @(item.Category != null ? item.Category.Title : "-")
                                        </td>

                                        <td>
                                            @(item.Doctor != null ? item.Doctor.FullName : "-")
                                        </td>

                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge badge-success">Hiện</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Ẩn</span>
                                            }
                                        </td>

                                        <td>
                                            <a asp-action="Edit"
                                               asp-route-id="@item.ServiceId"
                                               class="btn btn-sm btn-primary">Sửa</a>

                                            <a asp-action="Details"
                                               asp-route-id="@item.ServiceId"
                                               class="btn btn-sm btn-info">Chi tiết</a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.ServiceId"
                                               class="btn btn-sm btn-danger"
                                               onclick="return confirm('Bạn có chắc muốn xóa dịch vụ này?');">
                                                Xóa
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
