@model Doan.Models.TbService

@{
    ViewData["Title"] = "Xóa dịch vụ";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper mt-3">
    <div class="row justify-content-center">
        <div class="col-md-9">

            <div class="card card-danger">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-exclamation-triangle"></i>
                        Xác nhận xóa dịch vụ
                    </h3>
                </div>

                <div class="card-body">

                    <!-- Cảnh báo -->
                    <div class="alert alert-danger text-center">
                        Bạn có chắc chắn muốn xóa dịch vụ này?
                        <br />
                        <strong>Hành động này không thể hoàn tác!</strong>
                    </div>

                    <div class="row">

                        <!-- Ảnh + thông tin nhanh -->
                        <div class="col-md-4 text-center">
                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <img src="@Model.Image"
                                     class="img-thumbnail mb-3"
                                     style="width:180px;height:180px;object-fit:cover;border-radius:10px;" />
                            }
                            else
                            {
                                <div class="border rounded p-4 text-muted mb-3">
                                    Không có ảnh
                                </div>
                            }

                            <h4>@Model.Title</h4>

                            <p class="text-muted">
                                @(Model.Category != null ? Model.Category.Title : "Không có danh mục")
                            </p>

                            <div>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Hiển thị</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Ẩn</span>
                                }

                                @if (Model.IsNew)
                                {
                                    <span class="badge bg-info">Mới</span>
                                }

                                @if (Model.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark">Nổi bật</span>
                                }
                            </div>
                        </div>

                        <!-- Thông tin chi tiết -->
                        <div class="col-md-8">
                            <dl class="row">

                                <dt class="col-sm-4">Alias</dt>
                                <dd class="col-sm-8">@Model.Alias</dd>

                                <dt class="col-sm-4">Mô tả ngắn</dt>
                                <dd class="col-sm-8">@Model.ShortDescription</dd>

                                <dt class="col-sm-4">Chi tiết</dt>
                                <dd class="col-sm-8">@Model.Detail</dd>

                                <dt class="col-sm-4">Giá</dt>
                                <dd class="col-sm-8">
                                    @(Model.Price.HasValue
                                        ? Model.Price.Value.ToString("#,##0") + " VNĐ"
                                        : "-")
                                </dd>

                                <dt class="col-sm-4">Giá khuyến mãi</dt>
                                <dd class="col-sm-8">
                                    @(Model.PriceSale.HasValue
                                        ? Model.PriceSale.Value.ToString("#,##0") + " VNĐ"
                                        : "-")
                                </dd>

                                <dt class="col-sm-4">Bác sĩ phụ trách</dt>
                                <dd class="col-sm-8">
                                    @(Model.Doctor != null ? Model.Doctor.FullName : "-")
                                </dd>

                                <dt class="col-sm-4">Thứ tự hiển thị</dt>
                                <dd class="col-sm-8">@Model.Position</dd>

                                <dt class="col-sm-4">Ngày tạo</dt>
                                <dd class="col-sm-8">
                                    @Model.CreatedDate?.ToString("dd/MM/yyyy HH:mm")
                                </dd>

                                <dt class="col-sm-4">Người tạo</dt>
                                <dd class="col-sm-8">@Model.CreatedBy</dd>

                                <dt class="col-sm-4">Ngày sửa</dt>
                                <dd class="col-sm-8">
                                    @Model.ModifiedDate?.ToString("dd/MM/yyyy HH:mm")
                                </dd>

                                <dt class="col-sm-4">Người sửa</dt>
                                <dd class="col-sm-8">@Model.ModifiedBy</dd>

                            </dl>
                        </div>

                    </div>
                </div>

                <!-- Footer -->
                <div class="card-footer text-center">
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="ServiceId" />

                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash-alt"></i> Xóa ngay
                        </button>

                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-arrow-left"></i> Quay lại
                        </a>
                    </form>
                </div>

            </div>

        </div>
    </div>
</div>
