@model Doan.Models.TbService

@{
    ViewData["Title"] = "Sửa dịch vụ";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="row">
        <div class="col-md-10 mx-auto">

            <div class="card card-primary mt-3">
                <div class="card-header">
                    <h3 class="card-title">Sửa dịch vụ</h3>
                </div>

                <form asp-action="Edit" method="post">
                    <div class="card-body">

                        <!-- KHÓA CHÍNH -->
                        <input type="hidden" asp-for="ServiceId" />

                        <!-- GIỮ NGUYÊN THÔNG TIN TẠO -->
                        <input type="hidden" asp-for="CreatedDate" />
                        <input type="hidden" asp-for="CreatedBy" />

                        <div class="row">
                            <!-- CỘT TRÁI -->
                            <div class="col-md-6">

                                <div class="form-group">
                                    <label asp-for="Title">Tiêu đề</label>
                                    <input asp-for="Title" class="form-control" />
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Alias">Alias</label>
                                    <input asp-for="Alias" class="form-control" />
                                    <span asp-validation-for="Alias" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="CategoryId">Danh mục</label>
                                    <select asp-for="CategoryId"
                                            class="form-control"
                                            asp-items="ViewBag.CategoryId">
                                        <option value="">-- Chọn danh mục --</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label asp-for="ShortDescription">Mô tả ngắn</label>
                                    <textarea asp-for="ShortDescription"
                                              class="form-control"
                                              rows="3"></textarea>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Detail">Chi tiết</label>
                                    <textarea asp-for="Detail"
                                              class="form-control"
                                              rows="5"></textarea>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Position">Thứ tự hiển thị</label>
                                    <input asp-for="Position" type="number" class="form-control" />
                                </div>

                            </div>

                            <!-- CỘT PHẢI -->
                            <div class="col-md-6">

                                <div class="form-group">
                                    <label asp-for="Image">Ảnh dịch vụ</label>
                                    <div class="input-group mb-2">
                                        <input asp-for="Image"
                                               id="Image"
                                               class="form-control"
                                               readonly />
                                        <div class="input-group-append">
                                            <button type="button"
                                                    class="btn btn-info"
                                                    onclick="openImageManager()">
                                                Chọn ảnh
                                            </button>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(Model.Image))
                                    {
                                        <img id="previewImg"
                                             src="@Model.Image"
                                             class="img-thumbnail"
                                             style="width:150px;height:150px;object-fit:cover;border-radius:8px" />
                                    }
                                </div>

                                <div class="form-group">
                                    <label asp-for="Price">Giá</label>
                                    <input asp-for="Price" type="number" class="form-control" />
                                </div>

                                <div class="form-group">
                                    <label asp-for="PriceSale">Giá khuyến mãi</label>
                                    <input asp-for="PriceSale" type="number" class="form-control" />
                                </div>

                                <div class="form-group">
                                    <label asp-for="DoctorId">Bác sĩ phụ trách</label>
                                    <select asp-for="DoctorId"
                                            class="form-control"
                                            asp-items="ViewBag.DoctorId">
                                        <option value="">-- Chọn bác sĩ --</option>
                                    </select>
                                </div>

                                <!-- TRẠNG THÁI -->
                                <div class="form-group form-check">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label">Hiển thị</label>
                                </div>

                                <div class="form-group form-check">
                                    <input asp-for="IsNew" class="form-check-input" />
                                    <label asp-for="IsNew" class="form-check-label">Dịch vụ mới</label>
                                </div>

                                <div class="form-group form-check">
                                    <input asp-for="IsFeatured" class="form-check-input" />
                                    <label asp-for="IsFeatured" class="form-check-label">Nổi bật</label>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- FOOTER -->
                    <div class="card-footer text-center">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Lưu thay đổi
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Quay lại
                        </a>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openImageManager() {
            window.open('/Admin/Image/Index', 'popup', 'width=900,height=600');
        }

        function setSelectedImage(imageUrl) {
            document.getElementById("Image").value = imageUrl;
            document.getElementById("previewImg").src = imageUrl;
        }
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
