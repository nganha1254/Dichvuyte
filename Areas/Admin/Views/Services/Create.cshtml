@model Doan.Models.TbService

@{
    ViewData["Title"] = "Thêm dịch vụ";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="row">
        <div class="col-md-8">
            <div class="card card-primary">
                <div class="card-header">
                    <h3 class="card-title">Thêm dịch vụ</h3>
                </div>

                <form asp-action="Create" method="post">
                    <div class="card-body">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- Tiêu đề -->
                        <div class="form-group">
                            <label asp-for="Title">Tiêu đề</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <!-- Alias -->
                        <div class="form-group">
                            <label asp-for="Alias">Alias</label>
                            <input asp-for="Alias" class="form-control" />
                            <span asp-validation-for="Alias" class="text-danger"></span>
                        </div>

                        <!-- Danh mục -->
                        <div class="form-group">
                            <label asp-for="CategoryId">Danh mục</label>
                            <select asp-for="CategoryId"
                                    asp-items="ViewBag.CategoryId"
                                    class="form-control">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <!-- Bác sĩ -->
                        <div class="form-group">
                            <label asp-for="DoctorId">Bác sĩ phụ trách</label>
                            <select asp-for="DoctorId"
                                    asp-items="ViewBag.DoctorId"
                                    class="form-control">
                                <option value="">-- Chọn bác sĩ --</option>
                            </select>
                            <span asp-validation-for="DoctorId" class="text-danger"></span>
                        </div>

                        <!-- Mô tả ngắn -->
                        <div class="form-group">
                            <label asp-for="ShortDescription">Mô tả ngắn</label>
                            <textarea asp-for="ShortDescription"
                                      class="form-control"
                                      rows="3"></textarea>
                            <span asp-validation-for="ShortDescription" class="text-danger"></span>
                        </div>

                        <!-- Chi tiết -->
                        <div class="form-group">
                            <label asp-for="Detail">Chi tiết</label>
                            <textarea asp-for="Detail"
                                      class="form-control"
                                      rows="5"></textarea>
                            <span asp-validation-for="Detail" class="text-danger"></span>
                        </div>

                        <!-- Ảnh -->
                        <div class="form-group">
                            <label asp-for="Image">Ảnh</label>
                            <div class="input-group">
                                <input asp-for="Image"
                                       id="Image"
                                       class="form-control"
                                       readonly />
                                <div class="input-group-append">
                                    <button type="button"
                                            class="btn btn-info"
                                            onclick="openImageManager()">
                                        Chọn ảnh
                                    </button>
                                </div>
                            </div>
                            <span asp-validation-for="Image" class="text-danger"></span>
                        </div>

                        <!-- Giá -->
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label asp-for="Price">Giá</label>
                                <input asp-for="Price"
                                       type="number"
                                       class="form-control" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            <div class="form-group col-md-4">
                                <label asp-for="PriceSale">Giá khuyến mãi</label>
                                <input asp-for="PriceSale"
                                       type="number"
                                       class="form-control" />
                                <span asp-validation-for="PriceSale" class="text-danger"></span>
                            </div>

                            <div class="form-group col-md-4">
                                <label asp-for="Position">Thứ tự</label>
                                <input asp-for="Position"
                                       type="number"
                                       class="form-control" />
                                <span asp-validation-for="Position" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- SEO -->
                        <div class="form-group">
                            <label asp-for="SeoTitle">SEO Title</label>
                            <input asp-for="SeoTitle" class="form-control" />
                        </div>

                        <div class="form-group">
                            <label asp-for="SeoDescription">SEO Description</label>
                            <textarea asp-for="SeoDescription"
                                      class="form-control"
                                      rows="2"></textarea>
                        </div>

                        <div class="form-group">
                            <label asp-for="SeoKeywords">SEO Keywords</label>
                            <input asp-for="SeoKeywords" class="form-control" />
                        </div>

                        <!-- Checkbox -->
                        <div class="form-group form-check">
                            <label class="form-check-label">
                                <input asp-for="IsNew" class="form-check-input" />
                                Dịch vụ mới
                            </label>
                        </div>

                        <div class="form-group form-check">
                            <label class="form-check-label">
                                <input asp-for="IsFeatured" class="form-check-input" />
                                Nổi bật
                            </label>
                        </div>

                        <div class="form-group form-check">
                            <label class="form-check-label">
                                <input asp-for="IsActive" class="form-check-input" />
                                Hiển thị
                            </label>
                        </div>

                        <!-- Submit -->
                        <div class="form-group">
                            <input type="submit"
                                   value="Thêm mới"
                                   class="btn btn-primary" />
                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Quay lại
                            </a>
                        </div>

                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function openImageManager() {
            window.open(
                "/Admin/Image/Index",
                "Chọn ảnh",
                "width=900,height=600"
            );
        }

        function setSelectedImage(imageUrl) {
            document.getElementById("Image").value = imageUrl;
        }
    </script>
}
