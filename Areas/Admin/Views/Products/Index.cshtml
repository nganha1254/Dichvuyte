@model IEnumerable<Doan.Models.TbProduct>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="row">
        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Quản lý sản phẩm</h4>
                    <p class="card-description">
                        <a asp-action="Create" class="btn btn-success">Thêm mới</a>
                    </p>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Tiêu đề</th>
                                    <th>Alias</th>
                                    <th style="width:90px">Ảnh</th>
                                    <th>Giá</th>
                                    <th>Giá KM</th>
                                    <th>Danh mục</th>
                                    <th>Hiện</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int i = 1;
                                }
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@(i++)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Title)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Alias)</td>
                                        <td>
                                            <img src="~/assets/images/200x120/@item.Image" width="50" height="50" />
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.Price)</td>
                                        <td>@Html.DisplayFor(modelItem => item.PriceSale)</td>
                                        <td>
                                            @if (item.ProductCategory != null)
                                            {
                                                @Html.DisplayFor(modelItem => item.ProductCategory.ProductCategoryId)
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        
                                        <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                                        <td>
                                            <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-primary">Sửa</a> |
                                            <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-info">Chi tiết</a> |
                                            <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-danger">Xóa</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- content-wrapper ends -->
