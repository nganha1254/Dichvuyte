@model Doan.Models.TbProduct

@{
    ViewData["Title"] = "Xóa dịch vụ";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper mt-3">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card card-danger">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-exclamation-triangle"></i> Xác nhận xóa dịch vụ
                    </h3>
                </div>

                <div class="card-body">

                    <!-- Cảnh báo -->
                    <div class="alert alert-danger text-center">
                        Bạn có chắc chắn muốn xóa dịch vụ này?
                        <br />
                        <strong>Hành động này không thể hoàn tác!</strong>
                    </div>

                    <div class="row">

                        <!-- Ảnh -->
                        <div class="col-md-4 text-center">
                            <img src="@Model.Image"
                                 class="img-thumbnail mb-3"
                                 style="width:180px;height:180px;object-fit:cover;border-radius:10px;" />

                            <h4>@Model.Title</h4>
                            <p class="text-muted">@Model.ProductCategory?.Title</p>

                            <div>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Hiển thị</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Ẩn</span>
                                }

                                @if (Model.IsNew)
                                {
                                    <span class="badge bg-info">Mới</span>
                                }

                                @if (Model.IsPopular)
                                {
                                    <span class="badge bg-warning text-dark">Nổi bật</span>
                                }
                            </div>
                        </div>

                        <!-- Thông tin -->
                        <div class="col-md-8">
                            <dl class="row">

                                <dt class="col-sm-4">Alias</dt>
                                <dd class="col-sm-8">@Model.Alias</dd>

                                <dt class="col-sm-4">Mô tả</dt>
                                <dd class="col-sm-8">@Model.Description</dd>

                                <dt class="col-sm-4">Chi tiết</dt>
                                <dd class="col-sm-8">@Model.Detail</dd>

                                <dt class="col-sm-4">Giá</dt>
                                <dd class="col-sm-8">@Model.Price?.ToString("#,##0") VNĐ</dd>

                                <dt class="col-sm-4">Giá Sale</dt>
                                <dd class="col-sm-8">@Model.PriceSale?.ToString("#,##0") VNĐ</dd>

                                <dt class="col-sm-4">Thời lượng</dt>
                                <dd class="col-sm-8">@Model.Duration</dd>

                                <dt class="col-sm-4">Số Slot</dt>
                                <dd class="col-sm-8">@Model.SlotsAvailable</dd>

                                <dt class="col-sm-4">Số sao đánh giá</dt>
                                <dd class="col-sm-8">@Model.Star ★</dd>

                                <dt class="col-sm-4">Bác sĩ phụ trách</dt>
                                <dd class="col-sm-8">@Model.Doctor?.FullName</dd>

                                <dt class="col-sm-4">Ngày tạo</dt>
                                <dd class="col-sm-8">@Model.CreatedDate?.ToString("dd/MM/yyyy HH:mm")</dd>

                                <dt class="col-sm-4">Người tạo</dt>
                                <dd class="col-sm-8">@Model.CreatedBy</dd>

                                <dt class="col-sm-4">Ngày sửa</dt>
                                <dd class="col-sm-8">@Model.ModifiedDate?.ToString("dd/MM/yyyy HH:mm")</dd>

                                <dt class="col-sm-4">Người sửa</dt>
                                <dd class="col-sm-8">@Model.ModifiedBy</dd>

                            </dl>
                        </div>

                    </div>

                </div>

                <div class="card-footer text-center">
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="ProductId" />

                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash-alt"></i> Xóa ngay
                        </button>

                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-arrow-left"></i> Quay lại
                        </a>
                    </form>
                </div>

            </div>

        </div>
    </div>
</div>
