@model IEnumerable<Doan.Models.TbMenu>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="row">
        <div class="col-lg-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Quản lý menu</h4>
                    <p class="card-description">
                        <a asp-action="Create">Thêm mới</a>
                    </p>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Tiêu đề</th>
                                    <th>Alias</th>
                                    <th>Cấp</th>
                                    <th>Vị trí</th>
                                    <th>Hiện</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int i = 1;
                                }
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@(i++)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Title)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Alias)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Levels)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Position)</td>
                                        <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                                        <td>
                                            <a asp-action="Edit" asp-route-id="@item.MenuId" class="btn btn-primary">Sửa</a> |
                                            <a asp-action="Details" asp-route-id="@item.MenuId" class="btn btn-info">Chi tiết</a> |
                                            <a asp-action="Delete" asp-route-id="@item.MenuId" class="btn btn-danger">Xóa</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- content-wrapper ends -->
