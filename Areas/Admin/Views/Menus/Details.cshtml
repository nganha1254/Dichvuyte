@model Doan.Models.TbMenu

@{
    ViewData["Title"] = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="row">
        <div class="col-lg-8 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Chi tiết Menu</h4>

                    <hr />

                    <dl class="row">

                        <dt class="col-sm-3">Tiêu đề</dt>
                        <dd class="col-sm-9">@Model.Title</dd>

                        <dt class="col-sm-3">Alias</dt>
                        <dd class="col-sm-9">@Model.Alias</dd>

                        <dt class="col-sm-3">Mô tả</dt>
                        <dd class="col-sm-9">@Model.Description</dd>

                        <dt class="col-sm-3">Cấp</dt>
                        <dd class="col-sm-9">@Model.Levels</dd>

                        <dt class="col-sm-3">Menu cha</dt>
                        <dd class="col-sm-9">@Model.ParentId</dd>

                        <dt class="col-sm-3">Vị trí</dt>
                        <dd class="col-sm-9">@Model.Position</dd>

                        <dt class="col-sm-3">Ngày tạo</dt>
                        <dd class="col-sm-9">@Model.CreatedDate?.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Người tạo</dt>
                        <dd class="col-sm-9">@Model.CreatedBy</dd>

                        <dt class="col-sm-3">Ngày sửa</dt>
                        <dd class="col-sm-9">@Model.ModifiedDate?.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Người sửa</dt>
                        <dd class="col-sm-9">@Model.ModifiedBy</dd>

                        <dt class="col-sm-3">Kích hoạt</dt>
                        <dd class="col-sm-9">
                            @if (Model.IsActive == true)
                            {
                                <span class="badge bg-success">Hiển thị</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Ẩn</span>
                            }
                        </dd>

                    </dl>

                    <div class="mt-3">
                        <a asp-action="Edit" asp-route-id="@Model.MenuId" class="btn btn-primary">Sửa</a>
                        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
