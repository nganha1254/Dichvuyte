@model Doan.Models.TbMenu

@{
    ViewData["Title"] = "Xóa Menu";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper mt-3">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card card-danger">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-exclamation-triangle"></i> Xác nhận xóa menu
                    </h3>
                </div>

                <div class="card-body">

                    <!-- Cảnh báo -->
                    <div class="alert alert-danger text-center">
                        Bạn có chắc chắn muốn xóa menu này?<br />
                        <strong>Hành động này không thể hoàn tác!</strong>
                    </div>

                    <dl class="row">

                        <dt class="col-sm-4">Tiêu đề</dt>
                        <dd class="col-sm-8">@Model.Title</dd>

                        <dt class="col-sm-4">Alias</dt>
                        <dd class="col-sm-8">@Model.Alias</dd>

                        <dt class="col-sm-4">Mô tả</dt>
                        <dd class="col-sm-8">@Model.Description</dd>

                        <dt class="col-sm-4">Mức</dt>
                        <dd class="col-sm-8">@Model.Levels</dd>

                        <dt class="col-sm-4">Menu cha</dt>
                        <dd class="col-sm-8">
                            @(Model.ParentId == null ? "Không có" : Model.ParentId.ToString())
                        </dd>

                        <dt class="col-sm-4">Vị trí</dt>
                        <dd class="col-sm-8">@Model.Position</dd>

                        <dt class="col-sm-4">Trạng thái</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Đang hiển thị</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Đang ẩn</span>
                            }
                        </dd>

                    </dl>

                </div>

                <div class="card-footer text-center">
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="MenuId" />

                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash-alt"></i> Xóa
                        </button>

                        <a asp-action="Index" class="btn btn-secondary px-4 ml-2">
                            <i class="fas fa-arrow-left"></i> Quay lại
                        </a>
                    </form>
                </div>

            </div>

        </div>
    </div>
</div>
