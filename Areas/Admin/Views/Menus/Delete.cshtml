@model Doan.Models.TbMenu

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="row">
        <div class="col-md-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Xóa menu</h4>
                    <p class="card-description">
                        Xóa menu
                    </p>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="card card-primary">
                                <div class="card-header">
                                    <h3 class="card-title">Xóa menu</h3>
                                </div>
                                <!-- /.card-header -->
                                <!--form start-->
                                <div class="card-body">

                                    <div class="form-group">
                                        <label for="exampleInputEmail">Tiêu đề</label>
                                        @Html.DisplayFor(model => model.Title)
                                    </div>
                                    <div class="form-group">
                                        <label for="exampleInputPassword1">Alias</label>
                                        @Html.DisplayFor(model => model.Alias)
                                    </div>
                                    <div class="form-group">
                                        <label for="exampleInputPassword1">Mô tả</label>
                                        @Html.DisplayFor(model => model.Levels)
                                    </div>

                                    <div class="form-group">
                                        <label for="exampleInputPassword1">Mức</label>
                                        @Html.DisplayFor(model => model.Levels)
                                    </div>
                                    <div class="form-group">
                                        <label for="exampleInputPassword1">Menu cha</label>
                                        @Html.DisplayFor(model => model.Levels)
                                    </div>
                                    <div class="form-group">
                                        <label for="exampleInputPassword1">Hiện</label>
                                        @Html.DisplayFor(model => model.IsActive)
                                    </div>

                                    <form asp-action="Delete">
                                        <input type="hidden" asp-for="MenuId" />
                                        <input type="submit" value="Xóa" class="btn btn-danger" /> |
                                        <a asp-action="Index" class="btn btn-info">Quay lại</a>
                                    </form>
                                </div>


                                <!-- /.card-body -->
                            </div>
                            <!-- /.card -->
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<!-- content-wrapper ends -->
