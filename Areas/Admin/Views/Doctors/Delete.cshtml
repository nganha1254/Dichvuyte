@model Doan.Models.TbDoctor

@{
    ViewData["Title"] = "Xóa bác sĩ";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="row justify-content-center mt-4">
        <div class="col-md-8">

            <div class="card card-danger">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-exclamation-triangle"></i> Xác nhận xóa bác sĩ
                    </h3>
                </div>

                <div class="card-body">

                    <div class="alert alert-danger text-center">
                        Bạn có chắc chắn muốn xóa bác sĩ này?
                        <br />
                        <strong>Hành động này không thể hoàn tác!</strong>
                    </div>

                    <div class="row">
                        <!-- Ảnh bác sĩ -->
                        <div class="col-md-4 text-center">
                            <img src="@Model.Image"
                                 class="img-thumbnail mb-2"
                                 style="width:180px;height:180px;object-fit:cover;border-radius:10px" />

                            <h4 class="mt-2">@Model.FullName</h4>
                            <p class="text-muted">@Model.Position</p>
                        </div>

                        <!-- Thông tin -->
                        <div class="col-md-8">
                            <dl class="row">

                                <dt class="col-sm-5">Giới tính</dt>
                                <dd class="col-sm-7">@Model.Gender</dd>

                                <dt class="col-sm-5">Ngày sinh</dt>
                                <dd class="col-sm-7">@Model.DateOfBirth?.ToString("dd/MM/yyyy")</dd>

                                <dt class="col-sm-5">Điện thoại</dt>
                                <dd class="col-sm-7">@Model.Phone</dd>

                                <dt class="col-sm-5">Email</dt>
                                <dd class="col-sm-7">@Model.Email</dd>

                                <dt class="col-sm-5">Khoa</dt>
                                <dd class="col-sm-7">@Model.Category?.Title</dd>

                                <dt class="col-sm-5">Số năm kinh nghiệm</dt>
                                <dd class="col-sm-7">@Model.ExperienceYears năm</dd>

                                <dt class="col-sm-5">Tài khoản</dt>
                                <dd class="col-sm-7">@Model.Account?.Username</dd>

                            </dl>
                        </div>
                    </div>

                </div>

                <div class="card-footer text-center">
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="DoctorId" />

                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash-alt"></i> Xóa ngay
                        </button>

                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-arrow-left"></i> Quay lại
                        </a>
                    </form>
                </div>

            </div>

        </div>
    </div>
</div>
