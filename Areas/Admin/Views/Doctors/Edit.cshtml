@model Doan.Models.TbDoctor

@{
    ViewData["Title"] = "Edit Doctor";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="row">
        <div class="col-md-12">

            <div class="card card-primary">
                <div class="card-header">
                    <h3 class="card-title">Chỉnh sửa thông tin bác sĩ</h3>
                </div>

                <form asp-action="Edit" enctype="multipart/form-data">
                    <div class="card-body">

                        <input type="hidden" asp-for="DoctorId" />

                        <div class="row">
                            <!-- CỘT TRÁI -->
                            <div class="col-md-6">

                                <div class="form-group">
                                    <label asp-for="FullName"></label>
                                    <input asp-for="FullName" class="form-control" />
                                    <span asp-validation-for="FullName" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Gender"></label>
                                    <select asp-for="Gender" class="form-control">
                                        <option value="Nam">Nam</option>
                                        <option value="Nữ">Nữ</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label asp-for="DateOfBirth"></label>
                                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                                </div>

                                <div class="form-group">
                                    <label asp-for="Phone"></label>
                                    <input asp-for="Phone" class="form-control" />
                                </div>

                                <div class="form-group">
                                    <label asp-for="Email"></label>
                                    <input asp-for="Email" class="form-control" />
                                </div>

                                <div class="form-group">
                                    <label asp-for="Address"></label>
                                    <input asp-for="Address" class="form-control" />
                                </div>

                                <div class="form-group">
                                    <label asp-for="CategoryId">Chuyên khoa</label>
                                    <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
                                </div>

                            </div>

                            <!-- CỘT PHẢI -->
                            <div class="col-md-6">

                                <div class="form-group">
                                    <label asp-for="Position"></label>
                                    <input asp-for="Position" class="form-control" />
                                </div>

                                <div class="form-group">
                                    <label asp-for="Qualification"></label>
                                    <input asp-for="Qualification" class="form-control" />
                                </div>

                                <div class="form-group">
                                    <label asp-for="ExperienceYears"></label>
                                    <input asp-for="ExperienceYears" class="form-control" />
                                </div>

                                <div class="form-group">
                                    <label asp-for="Description"></label>
                                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                </div>

                                <!-- ẢNH -->
                                <div class="form-group">
                                    <label asp-for="Image" class="control-label">Ảnh</label>

                                    <div class="mt-2">
                                        <img id="previewImg"
                                             src="@Model.Image"
                                             class="img-thumbnail"
                                             style="width:150px;height:150px;object-fit:cover" />
                                    </div>

                                    <div class="input-group mb-3">
                                        <input id="Image" name="Image" class="form-control" value="@Model.Image" readonly />

                                        <button type="button" class="btn btn-info" onclick="openImageManager()">
                                            Chọn ảnh
                                        </button>
                                    </div>
                                </div>

                                <div class="form-group form-check">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label"></label>
                                </div>

                                <div class="form-group form-check">
                                    <input asp-for="IsNew" class="form-check-input" />
                                    <label asp-for="IsNew" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>

                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('previewImg').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
    <script>
        function openImageManager() {
            window.open('/Admin/Image/Index', 'popup', 'width=900,height=600');
        }

        // Hàm nhận ảnh từ popup
        function setSelectedImage(fileName) {
            document.getElementById("Image").value = fileName;
            document.getElementById("previewImg").src = "/uploads/" + fileName;
        }
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
