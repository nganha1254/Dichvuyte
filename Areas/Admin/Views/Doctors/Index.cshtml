@model IEnumerable<Doan.Models.TbDoctor>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="row">
        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Quản lý Bác sỹ</h4>
                    <p class="card-description">
                        <a asp-action="Create" class="btn btn-success">Thêm mới</a>
                    </p>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Tên</th>
                                    <th>Giới tính</th>
                                    <th style="width:90px">Ảnh</th>
                                    <th>Ngày sinh</th>
                                    <th>Số điện thoại</th>
                                    <th>Email</th>
                                    <th>Chức vụ</th>
                                    <th>Trình độ chuyên môn</th>
                                    <th>Số năm kinh nghiệm</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int i = 1;
                                }
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@(i++)</td>
                                        <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Gender)</td>
                                        <td>
                                            <img src="~/assets/images/200x120/@item.Image" width="50" height="50" />
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.DateOfBirth)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                                       
                                        <!-- Email -->
                                        <td>@Html.DisplayFor(modelItem => item.Email)</td>

                                        <!-- Chức vụ -->
                                        <td>@Html.DisplayFor(modelItem => item.Position)</td>

                                        <!-- Khoa -->
                                        

                                        <!-- Số năm kinh nghiệm -->
                                        

                                        <!-- Nút chức năng -->

                                        <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                                        <td>
                                            <a asp-action="Edit" asp-route-id="@item.DoctorId" class="btn btn-primary">Sửa</a> |
                                            <a asp-action="Details" asp-route-id="@item.DoctorId" class="btn btn-info">Chi tiết</a> |
                                            <a asp-action="Delete" asp-route-id="@item.DoctorId" class="btn btn-danger">Xóa</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>