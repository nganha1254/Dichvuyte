@{
    Layout = null;
    ViewData["Title"] = "ChatAI";
}

<style>
    /* Widget container */
    #chatWidget {
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 340px;
        font-family: Arial, sans-serif;
        z-index: 99999;
    }

    /* Bubble icon (luôn hiện) */
    #chatBubble {
        width: 54px;
        height: 54px;
        border-radius: 999px;
        border: none;
        cursor: pointer;
        background: #fff;
        box-shadow: 0 8px 24px rgba(0,0,0,0.25);
        display: grid;
        place-items: center;
        font-size: 22px;
        position: absolute;
        right: 0;
        bottom: 0;
    }

    /* Panel chat */
    #chatPanel {
        width: 340px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.25);
        overflow: hidden;
        margin-bottom: 12px; /* chừa chỗ bubble */
        display: none; /* mặc định THU */
    }

    /* Header */
    #chatHeader {
        background: #4CAF50;
        color: #fff;
        padding: 12px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        user-select: none;
    }

        #chatHeader .title {
            display: flex;
            align-items: center;
            gap: 8px;
        }

    #chatCloseBtn {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        background: rgba(255,255,255,0.18);
        color: #fff;
        font-size: 16px;
        line-height: 32px;
    }

        #chatCloseBtn:hover {
            background: rgba(255,255,255,0.28);
        }

    /* Body */
    #chatBody {
        height: 420px;
        display: flex;
        flex-direction: column;
        background: #f5f5f5;
    }

    /* Chat box */
    #chatBox {
        flex: 1;
        padding: 10px;
        overflow-y: auto;
    }

    /* Tin nhắn */
    .msg-user {
        text-align: right;
        margin-bottom: 8px;
    }

        .msg-user span {
            background: #4CAF50;
            color: #fff;
            padding: 6px 10px;
            border-radius: 12px 12px 0 12px;
            display: inline-block;
            max-width: 80%;
            font-size: 14px;
            white-space: pre-wrap;
            word-break: break-word;
        }

    .msg-ai {
        text-align: left;
        margin-bottom: 8px;
    }

        .msg-ai span {
            background: #ffe5e5;
            color: #333;
            padding: 6px 10px;
            border-radius: 12px 12px 12px 0;
            display: inline-block;
            max-width: 80%;
            font-size: 14px;
            white-space: pre-wrap;
            word-break: break-word;
        }

    /* Form */
    #chatForm {
        display: flex;
        padding: 10px;
        border-top: 1px solid #ddd;
        background: #fff;
    }

    #questionInput {
        flex: 1;
        padding: 8px 12px;
        border-radius: 20px;
        border: 1px solid #ccc;
        outline: none;
        font-size: 14px;
    }

    #chatForm button {
        margin-left: 8px;
        padding: 8px 14px;
        border-radius: 20px;
        border: none;
        background: #4CAF50;
        color: #fff;
        cursor: pointer;
        font-size: 14px;
    }
</style>

<div id="chatWidget">
    <!-- Panel -->
    <div id="chatPanel">
        <div id="chatHeader">
            <div class="title">💬 Chat cùng MediNest</div>
            <button type="button" id="chatCloseBtn" aria-label="Thu gọn">×</button>
        </div>

        <div id="chatBody">
            <div id="chatBox">
                <div class="msg-ai">
                    <span>Xin chào! Tôi có thể giúp gì cho bạn hôm nay?</span>
                </div>
            </div>

            <!-- GIỮ NGUYÊN LOGIC -->
            <form id="chatForm">
                <input type="text" id="questionInput" placeholder="Hỏi về sản phẩm..." />
                <button type="submit">Gửi</button>
            </form>
        </div>
    </div>

    <!-- Bubble -->
    <button type="button" id="chatBubble" aria-label="Mở / Thu chat">💬</button>
</div>

<script>
    // ===== Helpers =====
    const chatPanel = document.getElementById("chatPanel");
    const chatBubble = document.getElementById("chatBubble");
    const chatHeader = document.getElementById("chatHeader");
    const chatCloseBtn = document.getElementById("chatCloseBtn");

    const STORAGE_KEY = "medinest_chat_open";
    const AUTO_COLLAPSE_MS = 45000;
    let idleTimer = null;

    function isOpen() {
        return chatPanel.style.display === "block";
    }

    function openChat() {
        chatPanel.style.display = "block";
        localStorage.setItem(STORAGE_KEY, "1");
        resetIdleTimer();

        // focus input cho tiện
        setTimeout(() => {
            const input = document.getElementById("questionInput");
            if (input) input.focus();
        }, 0);
    }

    function closeChat() {
        chatPanel.style.display = "none";
        localStorage.setItem(STORAGE_KEY, "0");
        clearIdleTimer();
    }

    function toggleChat() {
        isOpen() ? closeChat() : openChat();
    }

    function clearIdleTimer() {
        if (idleTimer) clearTimeout(idleTimer);
        idleTimer = null;
    }

    function resetIdleTimer() {
        clearIdleTimer();
        idleTimer = setTimeout(() => {
            if (isOpen()) closeChat();
        }, AUTO_COLLAPSE_MS);
    }

    // ===== MỞ/THU: bấm bubble hoặc header =====
    chatBubble.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleChat();
    });

    chatHeader.addEventListener("click", (e) => {
        // nếu bấm nút X thì không toggle 2 lần
        if (e.target === chatCloseBtn) return;
        toggleChat();
    });

    chatCloseBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        closeChat();
    });

    // ===== Click ra ngoài -> thu =====
    document.addEventListener("click", (e) => {
        if (!isOpen()) return;
        const widget = document.getElementById("chatWidget");
        if (widget && !widget.contains(e.target)) closeChat();
    });

    // ===== Có tương tác khi chat mở -> reset idle =====
    ["mousemove", "mousedown", "keydown", "touchstart", "scroll"].forEach(evt => {
        document.addEventListener(evt, () => {
            if (isOpen()) resetIdleTimer();
        }, { passive: true });
    });

    // ===== Restore trạng thái sau F5 =====
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved === "1") openChat(); else closeChat();


    // ===== GIỮ NGUYÊN LOGIC GỬI (chỉ thêm escape để khỏi dính XSS) =====
    function escapeHtml(str) {
        return String(str)
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    document.getElementById('chatForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const input = document.getElementById('questionInput');
        const question = input.value;
        if (!question) return;

        const chatBox = document.getElementById('chatBox');

        chatBox.innerHTML += `
            <div class="msg-user"><span>${escapeHtml(question)}</span></div>
        `;
        chatBox.scrollTop = chatBox.scrollHeight;
        input.value = "";

        resetIdleTimer();

        const response = await fetch('/Home/Chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question })
        });

        const data = await response.json();

        chatBox.innerHTML += `
            <div class="msg-ai"><span>${escapeHtml(data.answer)}</span></div>
        `;
        chatBox.scrollTop = chatBox.scrollHeight;
    });
</script>
