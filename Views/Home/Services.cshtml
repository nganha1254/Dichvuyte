@{
    ViewData["Title"] = "Dịch vụ";
    Layout = "_Layout";
}

<section id="services" class="services section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="services-grid">
            <div class="row g-4">

                <!-- 1. Khám tổng quát -->
                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-delay="200">
                    <div class="service-card primary-care">
                        <div class="service-header">
                            <div class="service-icon">
                                <i class="fas fa-heartbeat"></i>
                            </div>
                            <span class="service-category">Chăm sóc cơ bản</span>
                        </div>
                        <div class="service-body">
                            <h4>Khám tổng quát</h4>
                            <p>Đánh giá sức khỏe toàn diện và lập kế hoạch chăm sóc dự phòng cho mọi thành viên trong gia đình.</p>
                            <div class="service-features">
                                <span class="feature-badge">Theo dõi sức khỏe</span>
                                <span class="feature-badge">Chương trình chăm sóc</span>
                                <span class="feature-badge">Chăm sóc dự phòng</span>
                            </div>
                        </div>
                        <div class="service-footer">
                            <a href="https://localhost:7025/Appointment/Index" class="service-btn">
                                Đặt lịch khám
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 2. Dịch vụ Tim mạch -->
                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-delay="300">
                    <div class="service-card specialty-care featured">
                        <div class="service-header">
                            <div class="service-icon">
                                <i class="fas fa-heart"></i>
                            </div>
                            <span class="service-category">Chuyên khoa</span>
                            <div class="featured-badge">Phổ biến nhất</div>
                        </div>
                        <div class="service-body">
                            <h4>Dịch vụ Tim mạch</h4>
                            <p>Chăm sóc tim mạch chuyên sâu gồm chẩn đoán, điều trị và phục hồi sau phẫu thuật.</p>
                            <div class="service-features">
                                <span class="feature-badge">Phẫu thuật tim</span>
                                <span class="feature-badge">Điện tâm đồ (ECG)</span>
                                <span class="feature-badge">Phục hồi chức năng tim</span>
                            </div>
                        </div>
                        <div class="service-footer">
                            <a href="https://localhost:7025/Appointment/Index" class="service-btn">
                                Đặt lịch khám
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 3. Xét nghiệm -->
                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-delay="400">
                    <div class="service-card diagnostics">
                        <div class="service-header">
                            <div class="service-icon">
                                <i class="fas fa-vials"></i>
                            </div>
                            <span class="service-category">Chẩn đoán</span>
                        </div>
                        <div class="service-body">
                            <h4>Xét nghiệm – Cận lâm sàng</h4>
                            <p>Cung cấp đa dạng các xét nghiệm với thời gian trả kết quả nhanh và độ chính xác cao.</p>
                            <div class="service-features">
                                <span class="feature-badge">Xét nghiệm máu</span>
                                <span class="feature-badge">Giải phẫu bệnh</span>
                                <span class="feature-badge">Kết quả trong ngày</span>
                            </div>
                        </div>
                        <div class="service-footer">
                            <a href="https://localhost:7025/Appointment/Index" class="service-btn">
                                Đặt lịch xét nghiệm
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 4. Cấp cứu -->
                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-delay="500">
                    <div class="service-card emergency">
                        <div class="service-header">
                            <div class="service-icon">
                                <i class="fas fa-ambulance"></i>
                            </div>
                            <span class="service-category">Khẩn cấp</span>
                            <div class="status-indicator">Hoạt động 24/7</div>
                        </div>
                        <div class="service-body">
                            <h4>Trung tâm Cấp cứu</h4>
                            <p>Dịch vụ cấp cứu 24/7 với đội ngũ chuyên môn cao, khu chăm sóc tích cực và phẫu thuật cấp cứu.</p>
                            <div class="service-features">
                                <span class="feature-badge">Trung tâm cấp cứu</span>
                                <span class="feature-badge">Chăm sóc tích cực</span>
                                <span class="feature-badge">Phẫu thuật cấp cứu</span>
                            </div>
                        </div>
                        <div class="service-footer">
                            <a href="tel:911" class="service-btn emergency-btn">
                                Gọi cấp cứu
                                <i class="fas fa-phone"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 5. Sức khỏe phụ nữ -->
                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-delay="600">
                    <div class="service-card maternal">
                        <div class="service-header">
                            <div class="service-icon">
                                <i class="fas fa-baby"></i>
                            </div>
                            <span class="service-category">Sức khỏe sản phụ</span>
                        </div>
                        <div class="service-body">
                            <h4>Sức khỏe phụ nữ</h4>
                            <p>Chăm sóc thai kỳ từ lúc khám định kỳ đến hỗ trợ sinh và chăm sóc sau sinh.</p>
                            <div class="service-features">
                                <span class="feature-badge">Chăm sóc thai kỳ</span>
                                <span class="feature-badge">Hỗ trợ sinh nở</span>
                                <span class="feature-badge">Kế hoạch hóa gia đình</span>
                            </div>
                        </div>
                        <div class="service-footer">
                            <a href="https://localhost:7025/Contact" class="service-btn">
                                Tìm hiểu thêm
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 6. Tiêm chủng -->
                <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-delay="700">
                    <div class="service-card vaccination">
                        <div class="service-header">
                            <div class="service-icon">
                                <i class="fas fa-syringe"></i>
                            </div>
                            <span class="service-category">Phòng bệnh</span>
                        </div>
                        <div class="service-body">
                            <h4>Dịch vụ tiêm chủng</h4>
                            <p>Các chương trình tiêm chủng đầy đủ cho mọi độ tuổi, gồm vắc xin du lịch và tiêm phòng theo mùa.</p>
                            <div class="service-features">
                                <span class="feature-badge">Vắc xin du lịch</span>
                                <span class="feature-badge">Tiêm ngừa cúm</span>
                                <span class="feature-badge">Tiêm chủng trẻ em</span>
                            </div>
                        </div>
                        <div class="service-footer">
                            <a href="https://localhost:7025/Appointment/Index" class="service-btn">
                                Đặt lịch tiêm
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Thống kê -->
        <div class="services-stats" data-aos="fade-up" data-aos-delay="800">
            <div class="row">
                <div class="col-lg-3 col-md-6">
                    <div class="stat-item">
                        <div class="stat-number" data-purecounter-start="0" data-purecounter-end="25000" data-purecounter-duration="2"></div>
                        <div class="stat-label">Bệnh nhân đã phục vụ</div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="stat-item">
                        <div class="stat-number" data-purecounter-start="0" data-purecounter-end="150" data-purecounter-duration="2"></div>
                        <div class="stat-label">Chuyên gia y tế</div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="stat-item">
                        <div class="stat-number" data-purecounter-start="0" data-purecounter-end="18" data-purecounter-duration="2"></div>
                        <div class="stat-label">Chuyên khoa</div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="stat-item">
                        <div class="stat-number" data-purecounter-start="0" data-purecounter-end="24" data-purecounter-duration="2"></div>
                        <div class="stat-label">Giờ dịch vụ mỗi ngày</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Banner đặt lịch -->
        <div class="appointment-banner" data-aos="fade-up" data-aos-delay="900">
            <div class="banner-content">
                <div class="banner-text">
                    <h3>Bạn cần hỗ trợ y tế?</h3>
                    <p>Hãy đặt lịch để được các chuyên gia y tế của chúng tôi thăm khám và chăm sóc tốt nhất.</p>
                </div>
                <div class="banner-actions">
                    <a href="tel:911" class="btn-primary">Đặt lịch ngay</a>
                    <a href="tel:+15551234567" class="btn-secondary">
                        <i class="fas fa-phone"></i>
                        Gọi ngay
                    </a>
                </div>
            </div>
        </div>

    </div>

</section>
