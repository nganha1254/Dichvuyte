    <!-- Find A Doctor Section -->
    <section id="find-a-doctor" class="find-a-doctor section">

        <!-- Section Title -->
        <div class="container section-title" data-aos="fade-up">
            <h2>DANH MỤC CÁC BÁC SĨ </h2>
            <p>TÌM BÁC SĨ PHÙ HỢP VỚI NHU CẦU SỨC KHỎE CỦA BẠN.</p>
        </div><!-- End Section Title -->

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="row justify-content-center" data-aos="fade-up" data-aos-delay="200">
                <div class="col-lg-10">
                    <div class="search-header">
                        <h2>KHÁM PHÁ CHUYÊN GIA Y TẾ LÝ TƯỞNG CHO BẠN </h2>
                        <p> KẾT NỐI VỚI MẠNG LƯỚI BÁC SĨ VÀ CHUYÊN GIA Y TẾ ĐƯỢC CHỨNG NHẬN TRÊN MỌI CHUYÊN NGÀNH</p>
                    </div>

                    <div class="advanced-search-container">
                        <form class="search-form" action="forms/doctor-search.php" method="get">
                            <div class="search-row">
                                <div class="search-field">
                                    <label>Tên bác sĩ</label>
                                    <div class="input-group">
                                        <i class="bi bi-search"></i>
                                        <input type="text" class="form-control" name="doctor_name" placeholder="Nhập tên bác sĩ..">
                                    </div>
                                </div>
                                <div class="search-field">
                                    <label>Chuyên khoa y tế</label>
                                    <div class="select-group">
                                        <i class="bi bi-plus-circle"></i>
                                        <select class="form-select" name="specialty">
                                            <option value="">Chọn chuyên khoa</option>
                                            <option value="cardiology">Tim mạch học</option>
                                            <option value="neurology">Thần kinh học</option>
                                            <option value="orthopedics">Phẫu thuật chỉnh hình</option>
                                            <option value="pediatrics">Nhi khoa</option>
                                            <option value="dermatology">Da liễu</option>
                                            <option value="oncology">Điều trị ung thư</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="search-field">
                                    <label>Địa điểm</label>
                                    <div class="select-group">
                                        <i class="bi bi-geo-alt"></i>
                                        <select class="form-select" name="location">
                                            <option value="">Tất cả địa điểm</option>
                                            <option value="downtown">Trung tâm y tế khu trung tâm</option>
                                            <option value="northside">Bệnh viện miền bắc</option>
                                            <option value="westend">Bệnh viện miền trung</option>
                                        </select>
                                    </div>
                                </div>
                                <button type="submit" class="search-submit">
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="row justify-content-center" data-aos="fade-up" data-aos-delay="200">
                @await Component.InvokeAsync("Doctor")
            </div>

            <div class="text-center mt-5" data-aos="fade-up" data-aos-delay="700">
