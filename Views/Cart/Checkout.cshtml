@model Doan.Models.TbCart

@{
    Layout = null; // Bỏ layout để không hiển thị menu/header/footer
    ViewData["Title"] = "Xác Nhận Thanh Toán";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-5">
        <h2 class="mb-4">Xác Nhận Thanh Toán</h2>

        @if (Model.TbCartItems != null && Model.TbCartItems.Any())
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Dịch Vụ</th>
                        <th>Bác Sĩ</th>
                        <th>Số Lượng</th>
                        <th>Giá</th>
                        <th>Tổng</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.TbCartItems)
                    {
                        <tr>
                            <td>@item.Service?.Title</td>
                            <td>@item.DoctorName</td>
                            <td>@item.Quantity</td>
                            <td>@item.Price.ToString("N0") VNĐ</td>
                            <td>@((item.Quantity * item.Price).ToString("N0")) VNĐ</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="4" class="text-end">Tổng Tiền:</th>
                        <th>@Model.TbCartItems.Sum(ci => ci.Quantity * ci.Price).ToString("N0") VNĐ</th>
                    </tr>
                </tfoot>
            </table>

            <form asp-action="CheckoutConfirm" method="post">
                <button type="submit" class="btn btn-success">Xác nhận thanh toán</button>
            </form>

            <form asp-controller="Cart" asp-action="PayByBank" method="post">
                <input type="hidden" name="paymentMethod" value="VNBANK" />
                <button type="submit" class="btn btn-danger">
                    Thanh toán qua ngân hàng (VNPay)
                </button>
            </form>


        }
        else
        {
            <p>Giỏ hàng của bạn trống. Vui lòng thêm sản phẩm vào giỏ hàng để thanh toán.</p>
        }
    </div>
</body>
</html>
