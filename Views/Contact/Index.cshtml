@{
    ViewData["Title"] = "Contact";
}

<main class="main">

    <!-- Page Title -->
    <div class="page-title">
        <div class="heading">
            <div class="container">
                <div class="row d-flex justify-content-center text-center">
                    <div class="col-lg-8">
                        <h1 class="heading-title">LIÊN HỆ</h1>
                        <p class="mb-0">
                            Chúng tôi luôn nỗ lực mang đến dịch vụ chăm sóc sức khỏe tận tâm và chất lượng.
                            Đội ngũ bác sĩ giàu kinh nghiệm cam kết hỗ trợ bệnh nhân từ khâu thăm khám, chẩn đoán đến điều trị.
                            Mỗi bệnh nhân đều được lắng nghe và tư vấn kỹ lưỡng để đảm bảo hiệu quả điều trị tốt nhất.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <nav class="breadcrumbs">
            <div class="container">
                <ol>
                    <li><a asp-controller="Home" asp-action="Index">TRANG CHỦ</a></li>
                    <li class="current">Contact</li>
                </ol>
            </div>
        </nav>
    </div>
    <!-- End Page Title -->
    <!-- Contact Section -->
    <section id="contact" class="contact section">

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <!-- Info Boxes -->
            <div class="row gy-4">
                <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="info-box">
                        <i class="bi bi-geo-alt"></i>
                        <h3>Địa Chỉ Của Chúng Tôi</h3>
                        <p>4582 Magnolia Avenue<br>Riverside, CA 92506</p>
                    </div>
                </div>

                <div class="col-lg-4" data-aos="fade-up" data-aos-delay="300">
                    <div class="info-box">
                        <i class="bi bi-telephone"></i>
                        <h3>GỌI LIÊN HỆ </3>
                        <p>+1 (951) 684-9123<br>+1 (951) 787-4534</p>
                    </div>
                </div>

                <div class="col-lg-4" data-aos="fade-up" data-aos-delay="400">
                    <div class="info-box">
                        <i class="bi bi-envelope"></i>
                        <h3>Email </h3>
                        <p>contact@example.com<br>support@example.com</p>
                    </div>
                </div>
            </div>

            <!-- Map + Form -->
            <div class="row gy-4 mt-4">

                <!-- Google Map -->
                <div class="col-lg-6" data-aos="fade-up" data-aos-delay="500">
                    <div class="map-container">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3779.5486864094705!2d105.66593147550178!3d18.68423768244132!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3139ce6b1753ecf3%3A0x2c22736c0ff92953!2zNzAgTmd1eeG7hW4gxJDDrG5oIENoaeG7g3UsIEzDqiBM4bujaSwgVmluaCwgTmdo4buHIEFuLCBWaeG7h3QgTmFt!5e0!3m2!1svi!2s!4v1764482324597!5m2!1svi!2s" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                                allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>

                <!-- Contact Form MVC -->
                <div class="col-lg-6" data-aos="fade-up" data-aos-delay="600">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    <form id="contactForm" asp-action="Create" method="post" class="php-email-form">
                        <div class="row gy-3">
                            <div class="col-md-6">
                                <input type="text" id="c_name" name="name" class="form-control" placeholder="Nhập tên" required>
                            </div>

                            <div class="col-md-6">
                                <input type="email" id="c_email" name="email" class="form-control" placeholder="Nhập Email" required>
                            </div>

                            <div class="col-md-12">
                                <input type="text" id="c_phone" name="phone" class="form-control" placeholder="Số điện thoại" required>
                            </div>

                            <div class="col-md-12">
                                <textarea id="c_message" name="message" class="form-control" rows="10" placeholder="Nội dung chi tiết" required></textarea>
                            </div>

                            <div class="col-md-12 text-center">
                                <button type="button" id="c_submit">GỬI LIÊN HỆ</button>
                            </div>
                        </div>
                    </form>


                </div>
            </div>

            <!-- Social Icons -->
            <div class="social-links text-center mt-5" data-aos="zoom-in" data-aos-delay="700">
                <a href="#" class="twitter"><i class="bi bi-twitter"></i></a>
                <a href="#" class="facebook"><i class="bi bi-facebook"></i></a>
                <a href="#" class="instagram"><i class="bi bi-instagram"></i></a>
                <a href="#" class="linkedin"><i class="bi bi-linkedin"></i></a>
                <a href="#" class="youtube"><i class="bi bi-youtube"></i></a>
            </div>

        </div>

    </section>
    <!-- End Contact Section -->

</main>
@section Scripts {
<script>
    $(function () {

        $("#c_submit").click(function () {

            let _name = $("#c_name").val();
            let _phone = $("#c_phone").val();
            let _email = $("#c_email").val();
            let _message = $("#c_message").val();

            $.ajax({
                url: "/Contact/Create",
                type: "POST",
                data: {
                    name: _name,
                    phone: _phone,
                    email: _email,
                    message: _message
                },
                success: function (result) {
                    if (result.status === true) {
                        toastr.success("Gửi thành công!");
                        $("#contactForm")[0].reset();
                    } else {
                        toastr.error("Gửi thất bại!");
                    }
                },
                error: function () {
                    toastr.error("Lỗi kết nối server!");
                }
            });

        });

    });
</script>
}


