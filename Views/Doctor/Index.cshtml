@model IEnumerable<Doan.Models.TbDoctor>
<main class="main">

    <!-- Page Title -->
    <div class="page-title">
        <div class="heading">
            <div class="container">
                <div class="row d-flex justify-content-center text-center">
                    <div class="col-lg-8">
                        <h1 class="heading-title">Bác sỹ</h1>
                        <p class="mb-0">
                            Chúng tôi cam kết cung cấp dịch vụ y tế an toàn, chuyên nghiệp và tận tâm. Mỗi quy trình khám, xét nghiệm và điều trị đều được thực hiện với độ chính xác cao, đảm bảo quyền lợi và sức khỏe của bệnh nhân. Mọi thắc mắc của bệnh nhân sẽ được giải đáp nhanh chóng và minh bạch.
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <nav class="breadcrumbs">
            <div class="container">
                <ol>
                    <li><a href="index.html">Home</a></li>
                    <li class="current">Doctors</li>
                </ol>
            </div>
        </nav>
    </div><!-- End Page Title -->
    <!-- Doctors Section -->
    <section id="doctors" class="doctors section">

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <!-- Filterable Doctor Directory -->
            <div class="doctor-directory mb-5">
             

                <div class="isotope-layout" data-default-filter="*" data-layout="masonry" data-sort="original-order">
                    <ul class="directory-filters isotope-filters" data-aos="fade-up" data-aos-delay="200">
                        <li data-filter="*" class="filter-active">Bác sĩ</li>
                    </ul><!-- End Directory Filters -->

                    <div class="row gy-4 isotope-container" data-aos="fade-up" data-aos-delay="300">
                        @foreach (var item in Model)
                        {
                            <div class="col-lg-3 col-md-6 doctor-item isotope-item filter-cardiology">
                                <article class="doctor-card h-100">
                                    <figure class="doctor-media">
                                        <img src="@item.Image" class="img-fluid" alt="Dr. Amelia Brooks" loading="lazy">
                                        <span class="tag">@item.Position</span>
                                    </figure>
                                    <div class="doctor-content">
                                        <h3 class="doctor-name">@item.FullName</h3>
                                        <p class="doctor-title">@item.Qualification</p>
                                        <p class="doctor-desc">@item.Description</p>
                                        <div class="doctor-meta">
                                            <span class="badge dept">@item.ExperienceYears</span>
                                        </div>
                                        <div class="doctor-actions">
                                            <a href="https://localhost:7025/Appointment/Index" class="btn btn-sm btn-appointment">Đặt lịch</a>
                                            <a href="@($"/Doctor/{item.FullName.ToLower().Replace(" ", "-")}-{item.DoctorId}.html")"
                                               class="btn btn-sm btn-soft">
                                                Tiểu sử
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            </div>

                            <!-- End Directory Item -->
                        }
                    </div>
                </div><!-- End Minimal / Compact -->
                <!-- Doctor Profile with Tabs -->
                <div class="profile-tabs mt-5">
                    <div class="row g-4">
                        <div class="col-lg-4" data-aos="fade-right" data-aos-delay="150">
                            <div class="tab-profile-card">
                                <img src="~/assets/img/200x100/1-6-200x100.jpg" class="img-fluid rounded-3" alt="Dr. Henry James" loading="lazy">
                                <div class="pt-3">
                                    <h3 class="mb-1">Trịnh Văn Hiệp</h3>
                                    <p class="mb-2">Chuyên Ngoại Khoa</p>
                                    <div class="d-flex gap-2">
                                        <span class="badge cert">Bác sĩ đã qua chứng nhận chuyên khoa</span>
                                        <span class="badge years">9 năm</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-8" data-aos="fade-left" data-aos-delay="200">
                            <ul class="nav nav-pills mb-3" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#health-doctors-3-tab-1" type="button" role="tab" aria-controls="health-doctors-3-tab-1" aria-selected="true">Thông tin</button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" data-bs-toggle="pill" data-bs-target="#health-doctors-3-tab-2" type="button" role="tab" aria-controls="health-doctors-3-tab-2" aria-selected="false">Lịch trình</button>
                                </li>
                            </ul>
                            <div class="tab-content">
                                <div class="tab-pane fade show active" id="health-doctors-3-tab-1" role="tabpanel">
                                    <p>Các hoạt động và dịch vụ được thực hiện cẩn thận, hướng đến việc mang lại lợi ích cho bệnh nhân. Chúng tôi luôn nỗ lực hết mình để cung cấp dịch vụ chất lượng và hỗ trợ tốt nhất.</p>
                                    <ul class="list-unstyled mb-0">
                                        <li><i class="bi bi-check2-circle me-1"></i> Quan tâm đặc biệt đến liệu pháp miễn dịch</li>
                                        <li><i class="bi bi-check2-circle me-1"></i> Thành viên của ASCO</li>
                                        <li><i class="bi bi-check2-circle me-1"></i> Các chương trình tiếp cận cộng đồng</li>
                                    </ul>
                                </div>
                                <div class="tab-pane fade" id="health-doctors-3-tab-2" role="tabpanel">
                                    <div class="schedule-grid">
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <div class="slot">
                                                    <strong>thứ hai</strong>
                                                    <span>9:00 AM - 1:00 PM</span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="slot">
                                                    <strong>thứ 3</strong>
                                                    <span>12:00 PM - 6:00 PM</span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="slot">
                                                    <strong>thứ 4</strong>
                                                    <span>9:00 AM - 3:00 PM</span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="slot">
                                                    <strong>thứ 5</strong>
                                                    <span>10:00 AM - 4:00 PM</span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="slot">
                                                    <strong>thứ 6</strong>
                                                    <span>10:00 AM - 4:00 PM</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Doctor Profile with Tabs -->

            </div>

    </section><!-- /Doctors Section -->

</main>

