@model Doan.Models.TbService

<main class="main">

    <!-- Page Title -->
    <div class="page-title">
        <div class="heading">
            <div class="container">
                <div class="row d-flex justify-content-center text-center">
                    <div class="col-lg-8">
                        <h1 class="heading-title">@Model.Title</h1> <!-- Hiển thị tên dịch vụ -->
                        <p class="mb-0">
                            Odio et unde deleniti. Deserunt numquam exercitationem. Officiis quo
                            odio sint voluptas consequatur ut a odio voluptatem. Sit dolorum
                            debitis veritatis natus dolores. Quasi ratione sint. Sit quaerat
                            ipsum dolorem.
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <nav class="breadcrumbs">
            <div class="container">
                <ol>
                    <li><a href="@Url.Action("Index", "Service")">Home</a></li>
                    <li class="current">Service Details</li>
                </ol>
            </div>
        </nav>
    </div><!-- End Page Title -->
    <!-- Service Details 2 Section -->
    <section id="service-details-2" class="service-details-2 section">

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="row gy-5">

                <div class="col-lg-6" data-aos="zoom-in" data-aos-delay="200">
                    <div class="service-image">
                        <!-- Hiển thị ảnh dịch vụ -->
                        <img src="@Model.Image" alt="@Model.Title" class="img-fluid">
                        <div class="service-tag">
                            <span>Specialized Care</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6" data-aos="fade-left" data-aos-delay="300">
                    <div class="service-content">
                        <h2>@Model.Title</h2> <!-- Hiển thị tên dịch vụ -->
                        <p class="service-tagline">@Model.ShortDescription</p> <!-- Hiển thị mô tả ngắn -->
                        <!-- Mô tả chi tiết dịch vụ -->
                        <p>@Model.Detail</p>

                        <!-- Hiển thị tên bác sĩ phụ trách -->
                        <div class="service-doctor">
                            <strong>Doctor: </strong>
                            @Model.Doctor?.FullName <!-- Hiển thị tên bác sĩ -->
                        </div>

                        <div class="service-actions">
                            <a href="appointment.html" class="btn-primary">Schedule Consultation</a>
                            <a href="#" class="btn-secondary">Learn More</a>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </section><!-- /Service Details 2 Section -->

</main>
