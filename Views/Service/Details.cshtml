@model Doan.Models.TbService

<main class="main">

    <!-- Page Title -->
    <div class="page-title">
        <div class="heading">
            <div class="container">
                <div class="row d-flex justify-content-center text-center">
                    <div class="col-lg-8">
                        <h1 class="heading-title">Chi tiết dịch vụ</h1>
                        <p class="mb-0">
                            Thuốc và các liệu pháp liên quan đến các triệu chứng. Các thủ tục y tế cần thiết. Dịch vụ y tế nhằm giải quyết các vấn đề sức khỏe một cách an toàn và hiệu quả. Cần đánh giá và theo dõi tình trạng bệnh nhân. Việc chăm sóc phải tuân theo các quy trình chuẩn y tế.
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <nav class="breadcrumbs">
            <div class="container">
                <ol>
                    <li><a href="@Url.Action("Index", "Service")">Home</a></li>
                    <li class="current">Service Details</li>
                </ol>
            </div>
        </nav>
    </div>

    <!-- Service Details 2 Section -->
    <section id="service-details-2" class="service-details-2 section">

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="row gy-5">

                <div class="col-lg-6" data-aos="zoom-in" data-aos-delay="200">
                    <div class="service-image">
                        <img src="@Model.Image" alt="@Model.Title" class="img-fluid">
                        <div class="service-tag">
                            <span>@Model.SeoDescription</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6" data-aos="fade-left" data-aos-delay="300">
                    <div class="service-content">
                        <h2>@Model.Title</h2>
                        <p class="service-tagline">@Model.ShortDescription</p>

                        <!-- GIÁ DỊCH VỤ (GIÁ GỐC) -->
                        <div class="service-price">
                            <strong>Price: </strong>
                            @String.Format("{0:N0} đ", Model.Price)
                        </div>
                        <!-- END GIÁ -->

                        <p>@Model.Detail</p>

                        <div class="service-doctor">
                            <strong>Doctor: </strong>
                            @Model.Doctor?.FullName
                        </div>

                        <div class="service-actions">
                            <a href="appointment.html" class="btn-primary">Đặt lịch khám tư vấn</a>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </section>

</main>
